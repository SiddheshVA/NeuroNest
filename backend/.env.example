# Copy to backend/.env.properties (loaded via spring.config.import) or export as
# environment variables. Never commit real values.

# Database (Neon Postgres) — JDBC URL, e.g. jdbc:postgresql://<host>/<db>?sslmode=require
DB_URL=
DB_USER=
DB_PASSWORD=

# AI providers
GROQ_API_KEY=
GEMINI_API_KEY=

# Auth
JWT_SECRET=
CLERK_JWKS_URL=
CLERK_ISSUER=

# Gmail SMTP (app password, not the account password)
MAIL_USERNAME=
MAIL_APP_PASSWORD=

# Admin dashboard login (required). ADMIN_JWT_SECRET: at least 32 characters, different from JWT_SECRET.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=

# Cloudinary (professional profile photos). From the Cloudinary dashboard, API Keys page.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (environment variables only, never .env.properties). The webhook secret is the one you set when
# adding the webhook in the Razorpay dashboard (URL: <backend>/api/payments/razorpay/webhook,
# events: payment.captured, order.paid, payment.failed).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Notifications. Links in every message start with APP_BASE_URL (set it to the deployed web app's address).
APP_BASE_URL=http://localhost:5173
NOTIFICATIONS_EMAIL_ENABLED=true
NOTIFICATIONS_WHATSAPP_ENABLED=false
NOTIFICATIONS_SMS_ENABLED=false
# TODO: fill in once a WhatsApp / SMS provider is chosen (not used yet).
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_SENDER=
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
