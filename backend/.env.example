# Copy to backend/.env.properties (loaded via spring.config.import) or export as
# environment variables. Never commit real values.

# Database (Neon Postgres) — JDBC URL, e.g. jdbc:postgresql://<host>/<db>?sslmode=require
DB_URL=
DB_USER=
DB_PASSWORD=

# AI providers
GROQ_API_KEY=
GEMINI_API_KEY=

# Auth
JWT_SECRET=
CLERK_JWKS_URL=
CLERK_ISSUER=

# Gmail SMTP (app password, not the account password)
MAIL_USERNAME=
MAIL_APP_PASSWORD=
