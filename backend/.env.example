# NeuroNest backend settings. Copy to backend/.env.properties for local development (gitignored; loaded
# whether the app starts from backend/ or from the repository root), or set them as environment variables
# on the host. Environment variables always win over the file. Never commit real values.
# [required] = the app will not start, or a core feature fails, without it. [optional] = has a safe default
# or switches a feature off when empty.
# Keys that have a default are commented out: an uncommented `KEY=` with nothing after it sets the value to
# an empty string, which replaces the default (and breaks number/boolean settings). Uncomment only to set a value.

# ---------- Server ----------
# [optional] HTTP port; most hosts set PORT themselves. Default 8080.
# PORT=

# ---------- Database (Postgres / Neon) ----------
# [required] JDBC URL, e.g. jdbc:postgresql://<host>/<db>?sslmode=require
DB_URL=
# [required] Database user.
DB_USER=
# [required] Database password.
DB_PASSWORD=

# ---------- Auth ----------
# [required] Secret for the app's own user JWTs (long random string).
JWT_SECRET=
# [required] Clerk JWKS URL, e.g. https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=
# [required] Clerk issuer, e.g. https://<your-instance>.clerk.accounts.dev
CLERK_ISSUER=
# [required for the professional portal] Clerk secret key (Clerk dashboard > API Keys).
CLERK_SECRET_KEY=
# [required] Admin dashboard login username.
ADMIN_USERNAME=
# [required] Admin dashboard login password.
ADMIN_PASSWORD=
# [required] Admin JWT secret: at least 32 characters, different from JWT_SECRET.
ADMIN_JWT_SECRET=

# ---------- AI (Neuro companion) ----------
# [required] Gemini API key.
GEMINI_API_KEY=
# [optional] Sarvam API key for Neuro's spoken replies (voices Aarti / Anand). Without it replies are
# read by the browser's own voice.
SARVAM_API_KEY=
# [optional] Groq API key; Groq is skipped when empty.
GROQ_API_KEY=

# ---------- Payments (Razorpay) ----------
# Without the key pair the app still starts and only payments are unavailable. Without the webhook secret
# every webhook delivery is refused. Webhook URL: <backend>/api/payments/razorpay/webhook
# (events: payment.captured, order.paid, payment.failed).
# [required for payments] Razorpay key id.
RAZORPAY_KEY_ID=
# [required for payments] Razorpay key secret.
RAZORPAY_KEY_SECRET=
# [required for payments] Secret set on the Razorpay webhook.
RAZORPAY_WEBHOOK_SECRET=

# ---------- Mail (SMTP) ----------
# [optional] SMTP host. Default smtp.gmail.com.
# MAIL_HOST=
# [optional] SMTP port. Default 587.
# MAIL_PORT=
# [required for email] SMTP username (the sending address).
MAIL_USERNAME=
# [required for email] SMTP password (for Gmail, an app password, not the account password).
MAIL_PASSWORD=
# [optional] Sender name shown in emails. Default NeuroNest.
# MAIL_FROM_NAME=

# ---------- Notifications ----------
# [optional] Email notifications on/off. Default true.
# NOTIFICATIONS_EMAIL_ENABLED=
# [optional] WhatsApp notifications on/off. Default false (no provider yet).
# NOTIFICATIONS_WHATSAPP_ENABLED=
# [optional] SMS notifications on/off. Default false (no provider yet).
# NOTIFICATIONS_SMS_ENABLED=
# [optional, unused until a provider is chosen] WhatsApp provider settings.
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_SENDER=
# [optional, unused until a provider is chosen] SMS provider settings.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# ---------- Storage ----------
# [required] Private folder for uploaded professional documents (absolute path, outside any web root). The app
# does not start without it; on the host it must be on persistent storage.
APP_STORAGE_DIR=
# [required for profile photos] Cloudinary cloud name (Cloudinary dashboard > API Keys).
CLOUDINARY_CLOUD_NAME=
# [required for profile photos] Cloudinary API key.
CLOUDINARY_API_KEY=
# [required for profile photos] Cloudinary API secret.
CLOUDINARY_API_SECRET=
# [optional] Cloudinary folder. Default neuronest/professionals.
# CLOUDINARY_FOLDER=

# ---------- Google Meet (video sessions) ----------
# OAuth client + refresh token for the NeuroNest Google account, scope
# https://www.googleapis.com/auth/meetings.space.created. Video links are not created when empty.
# [required for video links] OAuth client id.
GOOGLE_CLIENT_ID=
# [required for video links] OAuth client secret.
GOOGLE_CLIENT_SECRET=
# [required for video links] OAuth refresh token.
GOOGLE_REFRESH_TOKEN=

# ---------- Frontend URL / CORS ----------
# [required in production] The web app's address; every link in emails starts with it.
# Default http://localhost:5173.
# APP_BASE_URL=
# [required in production] Web app origins allowed to call the API, comma-separated (patterns such as
# https://*.example.com work). Default http://localhost:* (any local port).
# CORS_ALLOWED_ORIGINS=

# ---------- Background jobs ----------
# [required in production: true] Background jobs (booking expiry, reminders, expired registrations). Default false.
# JOBS_ENABLED=
# [optional] Minutes between background job runs. Default 10.
# JOBS_INTERVAL_MINUTES=
# [optional] One-time rename of older documents: "dry" or "apply". Leave empty normally.
RENAME_DOCUMENTS=
