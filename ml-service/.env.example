# NeuroNest ML service configuration (environment variables).
# The service does not read this file itself: set the variables in your shell,
# service manager or container. Never commit a real key.

# Shared secret that Spring Boot sends in the X-Internal-Key header.
# Required unless WELLNESS_DEV_MODE=1; at least 16 characters.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
WELLNESS_INTERNAL_KEY=change-me-to-a-long-random-secret

# 1 = local development only: allows a missing key (auth disabled) and
# enables the interactive docs at /docs. Keep 0 everywhere else.
WELLNESS_DEV_MODE=0

# Optional: directory with the model bundles (defaults to models/wellness).
WELLNESS_MODEL_DIR=
