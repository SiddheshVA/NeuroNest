# Copy to frontend/.env.local for local development; on the host, set these as build environment variables.
# Vite bakes VITE_* values into the built files, so only public values belong here, never secrets.

# Clerk publishable key (Clerk dashboard > API Keys). Required.
VITE_CLERK_PUBLISHABLE_KEY=

# Backend API address including /api, e.g. https://api.example.com/api. Optional locally (defaults to
# http://localhost:8080/api); required for a deployed build. VITE_API_BASE_URL is still read as a fallback.
VITE_API_URL=
